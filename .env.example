# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# NOTION INTEGRATION (Server-Side Only — Never Exposed to Client)
# Option A: Public OAuth 2.0 Integration (Recommended for multi-workspace popup connect)
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Option B: Internal Notion Integration Token (Direct server-side workspace token)
NOTION_API_KEY=""
